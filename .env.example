# Server Configuration
PORT=3000
HOST=0.0.0.0
# Your public tunnel or hosted URL (e.g., https://your-domain.ngrok-free.app or Railway URL)
PUBLIC_URL=

# OpenAI Realtime Configuration
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
# Voices available: alloy, echo, shimmer, ash, ballad, coral, sage, verse
AI_VOICE=alloy
AI_TEMPERATURE=0.7

# Twilio Telephony Configuration
# Get credentials at: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Destination phone number to escalate to if caller asks for a human supervisor
HUMAN_TRANSFER_NUMBER=
